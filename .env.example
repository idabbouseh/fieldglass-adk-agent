# Copy to .env and fill in. Never commit .env.

# LLM — get a free key at https://aistudio.google.com (API keys page)
GOOGLE_API_KEY=

# Model (bump as Google ships new Flash versions; re-run evals after every bump)
FG_AGENT_MODEL=gemini-2.5-flash

# Mock Fieldglass API (defaults work out of the box)
FG_BASE_URL=http://127.0.0.1:8085
FG_CLIENT_ID=demo-client
FG_CLIENT_SECRET=demo-secret
FG_API_KEY=demo-app-key
